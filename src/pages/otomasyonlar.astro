---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FinalCTA from '../components/FinalCTA.astro';
import InnerPageHero from '../components/InnerPageHero.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

const page = site.pages.automations;
---

<BaseLayout title={page.metaTitle} description={page.metaDescription}>
  <!--
    THESIS: Otomasyonu özellik listesiyle değil, sinyalden aksiyona ilerleyen görünür bir karar hattı olarak anlatır.
    OWN-WORLD: Karbon siyahı yüzey, sinyal kırmızısı konsol, ince metal çizgiler ve editoryal büyük tipografi.
    STORY: Ziyaretçi ihtiyacı tanır, akışın parçalarını görür, insan onayını anlar ve formda kendi sürecini tarif eder.
    FIRST VIEWPORT: Solda güçlü tez; sağda girdi-karar-aksiyon hattını taşıyan canlı kırmızı konsol.
    FORM: Persuade modu; tek yönlü akış rayı, yüksek kontrastlı bölümler ve kontrollü mikro hareket.
  -->
  <Header />
  <main id="main">
    <InnerPageHero
      label={page.hero.label}
      eyebrow={page.hero.eyebrow}
      title={page.hero.title}
      body={page.hero.body}
      variant="flow"
    />

    <section class="editorial-section signal-section" id="detay" data-reveal-section>
      <div class="page-shell editorial-grid">
        <div class="editorial-heading">
          <span class="section-label">İHTİYAÇ SİNYALLERİ</span>
          <h2>Otomasyon ihtiyacı çoğu zaman bir araç talebinden önce görünür.</h2>
        </div>
        <div class="signal-list">
          {page.signals.map((signal) => (
            <article class="signal-row">
              <span>{signal.number}</span>
              <div>
                <h3>{signal.title}</h3>
                <p>{signal.body}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="flow-story" data-reveal-section>
      <div class="page-shell">
        <div class="flow-story-heading">
          <span class="section-label">AKIŞ MİMARİSİ</span>
          <h2>Girdi → Karar → Aksiyon</h2>
          <p>Her adımın ne aldığı, hangi koşulla ilerlediği ve nerede insan onayı beklediği görünür kalır.</p>
        </div>

        <div class="expanded-flow">
          {site.automation.stages.map((stage, index) => (
            <article class="expanded-flow-step">
              <div class="flow-step-index">
                <span>{String(index + 1).padStart(2, '0')}</span>
                {index < site.automation.stages.length - 1 && <i aria-hidden="true"></i>}
              </div>
              <div class="flow-step-content">
                <span>{stage.tag}</span>
                <h3>{stage.title}</h3>
                <p>{stage.body}</p>
              </div>
            </article>
          ))}
        </div>

        <div class="human-control">
          <span class="control-orbit" aria-hidden="true"><i></i></span>
          <div>
            <span>İNSAN ONAYI</span>
            <h3>Kritik karar, otomasyonun içinde kaybolmaz.</h3>
            <p>Belirlenen eşiklerde akış durabilir, bağlamı gösterebilir ve yetkili kişinin kararıyla devam edebilir.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="editorial-section demo-section" data-reveal-section>
      <div class="page-shell editorial-grid">
        <div class="editorial-heading">
          <span class="section-label">DEMO GÖRÜNÜMLERİ</span>
          <h2>Teknik arka planı saklamadan, kullanıcıyı ayrıntıya boğmadan.</h2>
          <p class="section-disclaimer">Bu görünümler kavramsaldır; gerçek müşteri sistemi veya performans sonucu değildir.</p>
        </div>
        <div class="demo-ledger">
          {page.demos.map(([title, body], index) => (
            <article>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{title}</h3>
              <p>{body}</p>
              <Icon name="arrow-up-right" size={19} />
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="approach-bridge" data-reveal-section>
      <div class="page-shell approach-bridge-inner">
        <span class="section-label">ÇALIŞMA BİÇİMİ</span>
        <h2>Önce işleyişi dinler, sonra akışı haritalarız.</h2>
        <a class="text-link" href="/hakkimizda">Yaklaşımımızı keşfet <Icon name="arrow-up-right" size={18} /></a>
      </div>
    </section>

    <FinalCTA />
  </main>
  <Footer />
</BaseLayout>
