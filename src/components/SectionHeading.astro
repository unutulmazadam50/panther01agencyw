---
interface Props {
  label: string;
  title: string;
  body?: string;
  align?: 'left' | 'split';
}

const { label, title, body, align = 'split' } = Astro.props;
---

<header class:list={['section-heading', `section-heading--${align}`]}>
  <span class="section-label">{label}</span>
  <div>
    <h2>{title}</h2>
    {body && <p>{body}</p>}
  </div>
</header>
