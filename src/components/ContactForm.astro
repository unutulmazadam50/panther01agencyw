---
import Icon from './Icon.astro';
---

<form class="contact-form" action="/api/contact" method="post" data-contact-form>
  <div class="contact-form-grid">
    <div class="form-field">
      <label for="contact-name">Ad soyad</label>
      <input id="contact-name" name="name" type="text" autocomplete="name" minlength="2" maxlength="80" required aria-describedby="contact-name-error" />
      <small id="contact-name-error" class="field-error" data-error-for="name"></small>
    </div>

    <div class="form-field">
      <label for="contact-email">E-posta</label>
      <input id="contact-email" name="email" type="email" autocomplete="email" maxlength="254" required aria-describedby="contact-email-error" />
      <small id="contact-email-error" class="field-error" data-error-for="email"></small>
    </div>

    <div class="form-field form-field-wide">
      <label for="contact-company">Şirket <span>Opsiyonel</span></label>
      <input id="contact-company" name="company" type="text" autocomplete="organization" maxlength="120" aria-describedby="contact-company-error" />
      <small id="contact-company-error" class="field-error" data-error-for="company"></small>
    </div>

    <div class="form-field form-field-wide">
      <label for="contact-message">Neyi birlikte netleştirelim?</label>
      <textarea id="contact-message" name="message" rows="6" minlength="20" maxlength="3000" required aria-describedby="contact-message-help contact-message-error"></textarea>
      <div class="field-meta">
        <small id="contact-message-help">En az 20 karakter</small>
        <small id="contact-message-error" class="field-error" data-error-for="message"></small>
      </div>
    </div>
  </div>

  <label class="consent-field">
    <input name="consent" type="checkbox" required aria-describedby="contact-consent-error" />
    <span class="consent-box" aria-hidden="true"><Icon name="check" size={15} /></span>
    <span>
      Bilgilerimin iletişim talebimi yanıtlamak amacıyla işlenmesine ilişkin <a href="/kvkk" target="_blank" rel="noopener">KVKK Aydınlatma Metni’ni</a> okudum.
    </span>
  </label>
  <small id="contact-consent-error" class="field-error consent-error" data-error-for="consent"></small>

  <div class="contact-trap" aria-hidden="true">
    <label for="contact-website">Website</label>
    <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <input type="hidden" name="startedAt" data-started-at />
  <input type="hidden" name="submissionId" data-submission-id />

  <div class="contact-form-footer">
    <button class="button contact-submit" type="submit" data-submit>
      <span data-submit-label>Mesajı gönder</span>
      <span data-submit-pending hidden>Gönderiliyor…</span>
      <Icon name="arrow-up-right" size={18} />
    </button>
    <p class="form-status" data-form-status role="status" aria-live="polite"></p>
  </div>
</form>

<script>
  type ContactPayload = {
    ok: boolean;
    message?: string;
    fieldErrors?: Record<string, string[]>;
  };

  const makeId = () =>
    globalThis.crypto?.randomUUID?.() ??
    `${Date.now()}-${Math.random().toString(16).slice(2)}-${Math.random().toString(16).slice(2)}`;

  const setupContactForm = (form: HTMLFormElement) => {
    if (form.dataset.ready === 'true') return;
    form.dataset.ready = 'true';

    const startedAt = form.querySelector<HTMLInputElement>('[data-started-at]');
    const submissionId = form.querySelector<HTMLInputElement>('[data-submission-id]');
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]');
    const idleLabel = form.querySelector<HTMLElement>('[data-submit-label]');
    const pendingLabel = form.querySelector<HTMLElement>('[data-submit-pending]');
    const status = form.querySelector<HTMLElement>('[data-form-status]');
    const errorNodes = [...form.querySelectorAll<HTMLElement>('[data-error-for]')];

    const refreshSecurityFields = () => {
      if (startedAt) startedAt.value = String(Date.now());
      if (submissionId) submissionId.value = makeId();
    };

    const clearErrors = () => {
      errorNodes.forEach((node) => {
        node.textContent = '';
      });
      form.querySelectorAll('[aria-invalid="true"]').forEach((field) => field.removeAttribute('aria-invalid'));
    };

    const setPending = (pending: boolean) => {
      form.setAttribute('aria-busy', String(pending));
      if (submit) submit.disabled = pending;
      if (idleLabel) idleLabel.hidden = pending;
      if (pendingLabel) pendingLabel.hidden = !pending;
    };

    const showStatus = (message: string, isError: boolean) => {
      if (!status) return;
      status.textContent = message;
      status.classList.toggle('is-error', isError);
      status.classList.toggle('is-success', !isError && Boolean(message));
      status.setAttribute('role', isError ? 'alert' : 'status');
    };

    refreshSecurityFields();

    form.addEventListener('submit', async (event) => {
      if (!form.reportValidity()) return;
      event.preventDefault();
      clearErrors();
      showStatus('', false);
      setPending(true);

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        });

        let payload: ContactPayload | null = null;
        try {
          payload = (await response.json()) as ContactPayload;
        } catch {
          payload = null;
        }

        if (!response.ok || !payload?.ok) {
          if (payload?.fieldErrors) {
            Object.entries(payload.fieldErrors).forEach(([field, messages]) => {
              const errorNode = form.querySelector<HTMLElement>(`[data-error-for="${field}"]`);
              const input = form.elements.namedItem(field);
              if (errorNode) errorNode.textContent = messages?.[0] ?? '';
              if (input instanceof HTMLElement) input.setAttribute('aria-invalid', 'true');
            });
          }
          showStatus(payload?.message ?? 'İletişim servisi yapılandırılıyor. Lütfen tekrar deneyin.', true);
          return;
        }

        form.reset();
        refreshSecurityFields();
        showStatus(payload.message ?? 'Mesajınız alındı. En kısa sürede size döneceğiz.', false);
      } catch {
        showStatus('Bağlantı kurulamadı. Lütfen internet bağlantınızı kontrol edip tekrar deneyin.', true);
      } finally {
        setPending(false);
      }
    });
  };

  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach(setupContactForm);
</script>
